            <info compressed="false">https://raw.githubusercontent.com/ivarbrandt/ivarbrandt.github.io/main/packages/addons.xml</info>
            <checksum>https://raw.githubusercontent.com/ivarbrandt/ivarbrandt.github.io/main/packages/addons.xml.md5</checksum>
            <datadir zip="true">https://raw.githubusercontent.com/ivarbrandt/ivarbrandt.github.io/main/packages/</datadir>
        </dir>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary>ivarbrandt's Repository</summary>
        <description>Collection of Ivar Brandt's projects</description>
        <disclaimer />
        <platform>all</platform>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
